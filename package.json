{
  "name": "@redotech/redo-hydrogen",
  "version": "2.4.7",
  "description": "Utilities to enable and disable Redo coverage on Hydrogen stores",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types.d.ts",
  "scripts": {
    "dev": "rollup -c --watch --bundleConfigAsCjs",
    "build": "rollup -c --bundleConfigAsCjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "e2e": "npm run build && cd e2e && npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redoapp/redo-hydrogen.git"
  },
  "author": "Redo Tech <eng-hydrogen@getredo.com> (https://getredo.com)",
  "bugs": {
    "url": "https://github.com/redoapp/redo-hydrogen/issues"
  },
  "peerDependencies": {
    "@shopify/hydrogen": ">=2025.7.0",
    "@shopify/hydrogen-react": ">=2025.7.0",
    "react-dom": ">=18.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@shopify/hydrogen": "^2026.1.2",
    "@shopify/hydrogen-react": "^2026.1.1",
    "@svgr/rollup": "^8.1.0",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.13.2",
    "rollup": "^4.32.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1"
  },
  "keywords": [
    "Redo",
    "Returns",
    "Shopify",
    "Hydrogen"
  ],
  "homepage": "https://github.com/redoapp/redo-hydrogen#readme"
}
